@model PhamTuanAnh_2310900003.Models.PtaEmployee

@{
    ViewData["Title"] = "Chỉnh sửa nhân viên";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form asp-action="PtaEdit">
        <input type="hidden" asp-for="PtaEmpId" />

        <div class="mb-3">
            <label asp-for="PtaEmpName" class="form-label"></label>
            <input asp-for="PtaEmpName" class="form-control" />
            <span asp-validation-for="PtaEmpName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PtaEmpLevel" class="form-label"></label>
            <input asp-for="PtaEmpLevel" class="form-control" />
            <span asp-validation-for="PtaEmpLevel" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PtaEmpStartDate" class="form-label"></label>
            <input asp-for="PtaEmpStartDate" type="date" class="form-control" />
            <span asp-validation-for="PtaEmpStartDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PtaEmpStatus" class="form-label">Trạng thái</label>
            <select asp-for="PtaEmpStatus" class="form-select">
                <option value="true">Hiển thị</option>
                <option value="false">Ẩn</option>
            </select>
            <span asp-validation-for="PtaEmpStatus" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-warning">✅ Cập nhật</button>
        <a asp-action="PtaIndex" class="btn btn-secondary">⬅️ Quay lại</a>
    </form>
</div>
