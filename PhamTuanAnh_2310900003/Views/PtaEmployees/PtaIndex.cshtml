@model IEnumerable<PhamTuanAnh_2310900003.Models.PtaEmployee>

@{
    ViewData["Title"] = "Danh sách nhân viên";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    <div class="mb-3 text-end">
        <a asp-action="PtaCreate" class="btn btn-success">➕ Thêm nhân viên mới</a>
    </div>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-primary text-center">
            <tr>
                <th>Họ tên</th>
                <th>Trình độ</th>
                <th>Ngày bắt đầu</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PtaEmpName</td>
                    <td>@item.PtaEmpLevel</td>
                    <td>@(item.PtaEmpStartDate?.ToString("dd/MM/yyyy") ?? "")</td>
                    <td class="text-center">
                        <span class="badge @(item.PtaEmpStatus == true ? "bg-success" : "bg-secondary")">
                            @(item.PtaEmpStatus == true ? "Show" : "Hide")
                        </span>
                    </td>
                    <td class="text-center">
                        <a asp-action="PtaDetails" asp-route-id="@item.PtaEmpId" class="btn btn-info btn-sm me-1">🔍 Xem</a>
                        <a asp-action="PtaEdit" asp-route-id="@item.PtaEmpId" class="btn btn-warning btn-sm me-1">✏️ Sửa</a>
                        <a asp-action="PtaDelete" asp-route-id="@item.PtaEmpId" class="btn btn-danger btn-sm">🗑️ Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
