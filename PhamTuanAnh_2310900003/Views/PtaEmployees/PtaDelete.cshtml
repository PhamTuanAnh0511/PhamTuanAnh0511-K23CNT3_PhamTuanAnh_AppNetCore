@model PhamTuanAnh_2310900003.Models.PtaEmployee

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<div class="container mt-4">
    <h2 class="text-danger">@ViewData["Title"]</h2>

    <p>Bạn có chắc chắn muốn xóa nhân viên sau không?</p>

    <dl class="row">
        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.PtaEmpName</dd>

        <dt class="col-sm-3">Trình độ</dt>
        <dd class="col-sm-9">@Model.PtaEmpLevel</dd>

        <dt class="col-sm-3">Ngày bắt đầu</dt>
        <dd class="col-sm-9">@Model.PtaEmpStartDate?.ToString("dd/MM/yyyy") ?? ""</dd>

        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.PtaEmpStatus == true ? "bg-success" : "bg-secondary")">
                @(Model.PtaEmpStatus == true ? "Hiển thị" : "Ẩn")
            </span>
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="PtaEmpId" />
        <button type="submit" class="btn btn-danger">🗑️ Xác nhận xóa</button>
        <a asp-action="PtaIndex" class="btn btn-secondary">⬅️ Hủy</a>
    </form>
</div>
